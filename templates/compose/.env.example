# kit template — every placeholder in docker-compose.yml and otel-collector.yml.
#
#   cp .env.example .env
#
# WHY EVERY VALUE HAS A DEFAULT
#   docker-compose.yml substitutes ${KIT_POSTGRES_PORT:-5432}, so a fresh clone
#   runs with no .env at all. These defaults exist so that the file a developer
#   edits, and the file a teammate has in git, cannot disagree silently: copy
#   this, change what you need, and commit your own .env.example if you changed
#   a default.
#
# WHY NOTHING SENSITIVE IS HERE
#   These are development credentials for a container bound to the host
#   loopback. The real ones live in each service's deployment secrets, never in
#   a repo. If you find yourself wanting to put a production credential in this
#   file, you want a secrets manager instead.
#
# tests/validate.sh asserts that every ${KIT_*} used by the two templates
# appears below with a non-empty default. A placeholder used but undocumented
# fails the gate.

# ---------------------------------------------------------------- project
# Compose project name. This is the prefix on every container, volume, and
# network, so two checkouts on one machine do not collide.
KIT_STACK_NAME=cafaye

# ---------------------------------------------------------------- postgres
# Host port is the one value that collides with something already on your
# machine. Change it here rather than in docker-compose.yml.
KIT_POSTGRES_PORT=5432
KIT_POSTGRES_USER=cafaye
KIT_POSTGRES_PASSWORD=cafaye
# The platform database. A service creates its own database alongside it.
KIT_POSTGRES_DB=cafaye_platform
KIT_POSTGRES_TAG=16.6-alpine

# --------------------------------------------------------------------- nats
KIT_NATS_CLIENT_PORT=4222
# The monitoring port serves /healthz and /jsz, and is what the healthcheck
# probes. It exposes subject names and stream state, so it stays on loopback.
KIT_NATS_MONITOR_PORT=8222
KIT_NATS_TAG=2.10.24-alpine

# -------------------------------------------------------------------- redis
KIT_REDIS_PORT=6379
KIT_REDIS_TAG=7.4.1-alpine

# --------------------------------------------------------- otel collector
# Neither OTLP port is published to the host. These values are what services use
# to reach the collector over the compose network, by service name.
KIT_OTEL_GRPC_ENDPOINT=0.0.0.0:4317
KIT_OTEL_HTTP_ENDPOINT=0.0.0.0:4318
KIT_OTEL_HTTP_PORT=4318
KIT_OTEL_COLLECTOR_TAG=0.115.1
# memory_limiter: a percentage of the container's memory limit, not an absolute.
# Below 60 the collector starts shedding spans under a modest load spike, which
# looks like "my spans disappeared" to whoever is debugging.
KIT_OTEL_MEMORY_LIMIT_PERCENTAGE=75
KIT_OTEL_MEMORY_SPIKE_PERCENTAGE=15
# batch: a 5s timeout is the usual local compromise — long enough that a
# request burst is one batch, short enough that `docker compose logs -f` shows
# the span while you are still looking at it.
KIT_OTEL_BATCH_TIMEOUT=5s
KIT_OTEL_BATCH_SIZE=512
# basic is the collector's own logging, not the debug exporter's output.
KIT_OTEL_LOG_LEVEL=info
KIT_OTEL_HEALTH_ENDPOINT=0.0.0.0:13133
# The debug exporter writes every span it receives. `json` is one span per line,
# which is what grep and `docker compose logs` can consume; `detailed` is for
# when you are reading one span by hand.
KIT_OTEL_DEBUG_VERBOSITY=normal

# ------------------------------------------------------------- service env
# A service's own .env holds these, not this file. They are listed here because
# bin/dev prints them and because a service that cannot find one fails with a
# much worse error message than "this variable is not set".
#
#   OTEL_SERVICE_NAME=<repo name, lowercase>          e.g. caf
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#   OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#   OTEL_TRACES_SAMPLER=parentbased_traceidratio
#   OTEL_TRACES_SAMPLER_ARG=1.0
#   OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=cafaye
#
# parentbased_traceidratio is not an accident: it defers to the caller's
# sampled flag, so a trace the edge service chose to record is not dropped
# halfway through by a service with a different opinion. See
# templates/otel/README.md.
