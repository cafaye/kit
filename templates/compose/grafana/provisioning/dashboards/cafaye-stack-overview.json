    {
      "id": 10,
      "type": "row",
      "title": "What the redaction boundary let through",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "table",
      "title": "Attributes on the spans that arrived",
      "description": "The allowlist, made visible. core's schemas are the source of this list and `tests/validate.sh` in kit reads them off disk and compares both ways against the collector config — a name here that core does not allow, or one core allows and this list lacks, fails the gate. That is what makes 'the collector is the enforcement point' a fact rather than an intention.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_type, log_severity, scope_name, service_name) (count_over_time({service_name=~\".+\"}[5m]))",
          "queryType": "instant",
          "instant": true,
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__error_type": false,
              "__route": false,
              "__model": false
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
