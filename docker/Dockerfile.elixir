# kit template — Elixir/OTP service image. Copy to docker/Dockerfile.
#
#   docker build -f docker/Dockerfile --build-arg ELIXIR_VERSION=1.18.3 -t svc .
#
# STRICTNESS NOTES
#   - Two stages, `-slim` final. The ERTS (the BEAM runtime) is the whole
#     runtime, so this file never removes it; what we drop is the C toolchain,
#     git, and the hex/rebar build tools.
#   - deps are compiled in the builder, in release mode, and `_build` is copied
#     as-is. Compiling in the runtime stage means a slower first boot and an
#     image that changes whenever MIX_ENV leaks in from the environment.
#   - The final stage runs non-root, as `app` (uid 10001), created with a fixed
#     numeric uid so the image is reproducible. A container running as root is a
#     container where a bug is a host compromise.
#   - hex/rebar are installed as the app user, in the runtime stage, writing to
#     /app/.mix — never as root into /root/.mix, which the app user cannot read.
#   - THE ENTRYPOINT MIGRATES FIRST. `docker/entrypoint.sh` resolves this
#     repository's migration command, runs it against DATABASE_URL, and only then
#     `exec`s the release. A migration that fails refuses to start the service,
#     which is the point: it deletes the "service is healthy, schema is stale"
#     cold-start class that a bare `ENTRYPOINT ["/app/bin/app", "start"]` leaves
#     open.
#
#     ELIXIR SETS `KIT_MIGRATE_CMD` EXPLICITLY, and that is the one language
#     where it is not optional. `templates/bin/dev.sh` probes for `bin/ecto.setup`
#     and runs `mix ecto.create && mix ecto.migrate` — a DEVELOPER sequence,
#     against a mix project and a database it may have to create. A release has
#     no mix project and must not create a database at boot, so the entrypoint
#     deliberately does not copy that branch; point it at the release instead:
#
#         ENV KIT_MIGRATE_CMD=/app/bin/app eval "Ecto.Migrator.with_repo(_release, [_repo, _], fn repo -> Ecto.Migrator.run(repo, :up, all: true) end)"
#
#     Ecto's migrator keeps a `schema_migrations` table, so concurrent replicas
#     converge on one schema rather than duplicating work. Whether Ecto also
#     SERIALIZES them (an advisory lock) was **not verified while writing this
#     note** — read Ecto's `Ecto.Migrator` source for the version you deploy
#     before relying on it, and set `KIT_MIGRATE_ADVISORY_LOCK` if you cannot
#     find it there. `docker/entrypoint.sh` states only what it guarantees
#     itself, and this note deliberately does not claim more than it can show.
#   - `exec "$@"` inside that script, so after the migration the release replaces
#     the shell and is PID 1. An Elixir release is its own supervisor tree and
#     traps SIGTERM itself; the shell is gone before it starts.
ARG ELIXIR_VERSION=1.18.3
ARG OTP_VERSION=27.3.4

FROM elixir:${ELIXIR_VERSION}-otp-${OTP_VERSION}-slim AS build
ENV MIX_ENV=prod
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git \
    && rm -rf /var/lib/apt/lists/*
COPY mix.exs mix.lock ./
RUN mix local.hex --force && mix local.rebar --force
RUN mix deps.get --only prod && mix deps.compile
COPY . .
RUN mix compile && mix release

FROM elixir:${ELIXIR_VERSION}-otp-${OTP_VERSION}-slim AS runtime
ENV MIX_ENV=prod HOME=/app
WORKDIR /app
RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --create-home app
COPY --from=build --chown=app:app /app/_build /app/_build
COPY --from=build --chown=app:app /app/deps /app/deps
COPY --chown=app:app . /app
COPY --chown=app:app docker/entrypoint.sh /app/kit-entrypoint
USER app
RUN mix local.hex --force && mix local.rebar --force
EXPOSE 4000
# `app` is the :app name from mix.exs; mix release writes bin/app.
ENTRYPOINT ["/bin/sh", "/app/kit-entrypoint", "/app/bin/app", "start"]
